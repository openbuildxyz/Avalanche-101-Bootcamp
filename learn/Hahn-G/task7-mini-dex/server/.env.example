PORT=8787
JWT_SECRET=dev-secret-change-me
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# 留空 = 离线模式（不连链，开放 POST /dev/faucet 直接发测试余额）
# 填上 Deploy 脚本输出的地址 = 链上模式（监听 Vault Deposit 事件）
VAULT_ADDRESS=
USDC_ADDRESS=
WAVAX_ADDRESS=
# 链上模式：启动时从这个区块回放 Deposit/Withdraw 事件重建余额（填合约部署区块；留空 = 只监听新事件）
DEPOSIT_FROM_BLOCK=

# 后端签 Withdraw 授权用的私钥。
# 这是 anvil 内置账户 #1 的公开测试私钥，人人都知道，绝对不能用于真实资金！
BACKEND_SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# ---- 做市（可选）：把 Binance 盘口镜像到本所订单簿，让簿上有真实流动性 ----
# MARKET_MAKER=1 开启。做市账户是账本里的一个普通地址（默认 anvil 账户 #9）。
MARKET_MAKER=
MM_ADDRESS=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720
MM_SYMBOL=AVAXUSDT          # 镜像哪个 Binance 交易对
MM_LEVELS=10                # 每边取前几档
MM_SCALE=0.05               # 数量缩放比例（Binance 的 5%）
MM_INTERVAL_MS=2000         # 刷新间隔
MM_MIN_QTY=0.1              # 单档最小 / 最大数量（WAVAX）
MM_MAX_QTY=200
# 启动时给做市账户的虚拟余额（不走链上充值；设为 0 则只用它真实 deposit 的钱）
MM_SEED_USDC=100000
MM_SEED_WAVAX=10000
