# Avalanche Fuji Testnet RPC (public endpoint works, replace if rate-limited)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Snowtrace / Routescan API key for contract verification (optional)
SNOWTRACE_API_KEY=

# Deployer private key. NEVER commit the real value.
# A dedicated throwaway testnet key with no real value is strongly recommended.
PRIVATE_KEY=
