# Avalanche Fuji C-Chain RPC. The public endpoint can be replaced by a private provider.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Deployment account private key, with or without the 0x prefix.
# Never commit a real key or a funded mainnet key.
PRIVATE_KEY=0xYOUR_FUJI_TEST_ONLY_PRIVATE_KEY

# Initial off-chain proof URI/hash/registry reference recorded by the contract.
INITIAL_ASSET_DOCUMENT=ipfs://REPLACE_WITH_YOUR_SIMULATED_ASSET_REPORT_CID

# Optional CLI verification settings. Snowtrace accepts a placeholder key.
SNOWTRACE_API_KEY=placeholder
SNOWTRACE_API_URL=https://api-testnet.snowtrace.io/api

